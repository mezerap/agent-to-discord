DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_USER_ID=
AGENT_WORKSPACE=/workspace
# Keep bridge state outside the agent workspace, in a persistent volume.
AGENT_STATE_DIR=/home/node/.codex/agent-to-discord
# Optional; omit to inherit Codex's configured model.
# CODEX_MODEL=
# CODEX_BIN=codex
# Default: sandboxed (workspace-write with on-request approvals).
# Use container only inside an independently isolated container: full access, no approvals.
# AGENT_EXECUTION_MODE=sandboxed
